@page "/index"
@using System.Diagnostics

<table>
@for (int i = 0; i < 10; i++)
{
	<tr>
	@for (int j = 0; j < 10; j++)
	{
				<td @onclick="() => Trace.WriteLine(i)">
			<div style="width: 50px; height: 50px; border: 1px solid black;">
				<img width="30" height="30" src="data:image/png;base64," />
				<p></p>
			</div>
		</td>
	}
	</tr>
}
</table>

@functions
{
	async Task Debug(int x, int y)
	{
		Trace.WriteLine($"Clicked on cell ({x}, {y})");
	}
}